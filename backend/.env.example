# AI Fabric Environment Configuration
ENVIRONMENT=development
PORT=8000
DEBUG=True

# Supabase PostgreSQL Connection String (Asyncpg)
# Format: postgresql+asyncpg://postgres:<PASSWORD>@db.<PROJECT_REF>.supabase.co:5432/postgres
# Or Transaction Pooler: postgresql+asyncpg://postgres.<PROJECT_REF>:<PASSWORD>@aws-0-<REGION>.pooler.supabase.com:6543/postgres
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/postgres

# Groq API Key (For LLM Gateway execution)
GROQ_API_KEY=your_groq_api_key_here

# GitHub Personal Access Token (Optional: For live GitHub MCP server queries)
GITHUB_TOKEN=your_github_token_here

# MCP Settings
MCP_GITHUB_MODE=mock  # 'mock' or 'live'
